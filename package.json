{
  "name": "typelight",
  "productName": "Typelight",
  "desktopName": "com.typelight.app",
  "version": "0.1.0",
  "description": "A quiet, tactile place to write your first draft.",
  "author": "Typelight contributors",
  "homepage": "https://github.com/xwinus/typelight",
  "repository": { "type": "git", "url": "https://github.com/xwinus/typelight.git" },
  "license": "MIT",
  "private": true,
  "main": "desktop/electron/main.cjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "electron tests/electron-smoke.cjs && electron tests/recovery-runtime.cjs",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:linux": "electron-builder --linux --x64 --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
